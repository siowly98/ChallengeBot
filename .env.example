# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token

# The Google Sheet that holds applicant data (same sheet your Form writes to,
# or a sheet you maintain that's keyed by email). Copy the ID out of the
# sheet's URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
SHEET_ID=your-google-sheet-id

# Exact name of the worksheet/tab inside that spreadsheet
WORKSHEET_NAME=Applicants

# Path to the Google service account JSON key (see README setup steps).
# Used for local development. On a host like Railway, set
# GOOGLE_CREDENTIALS_JSON instead (paste the whole key file's content as
# the value) - the code prefers that when it's present.
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", ...}

# The Telegram group chat ID for your internal mod-only group.
# Add the bot to that group first, then see README for how to find this ID.
MOD_GROUP_CHAT_ID=-1001234567890

# How often (seconds) the bot checks the sheet for status changes
POLL_INTERVAL_SECONDS=30
